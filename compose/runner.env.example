# Copy to runner.env (gitignored) and fill values. Names only in git.
#   cp runner.env.example runner.env
#
# LOCAL_DEV=1 allows missing/empty X-Runner-Secret (plugin-author localhost only).
# NEVER set LOCAL_DEV=1 on test or prod. The runner refuses to start if you try.
#
# GIT_SHA is optional: stamped from this env, or `git rev-parse HEAD` in the mounted repo.
# v1 jobs come from the mounted checkout on the host. No deploy key required for Job 0.
#
# Bind (compose interpolation — also copy these two into compose/.env):
#   Default loopback + host port 8787 → container 8080.
#   Do not publish on a host port already used by another service; avoid host 8080
#   when something else owns it. For other machines, set RUNNER_HOST to a private
#   address and use http://YOUR_RUNNER_HOST:8787 as runner_url.

RUNNER_HOST=127.0.0.1
RUNNER_PORT=8787

RUNNER_SECRET=
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_KEY=
GIT_SHA=
LOCAL_DEV=0

# Optional sample job agent86-qa-dev (jobs/examples/) — values never in git. Names only.
# Primary login (qademo). Bypass OTP code goes in QA_PASSWORD.
QA_USER=
QA_PASSWORD=
# Fallback login if primary account is missing (googledemo). AUTH-01 fails; suite continues.
QA_USER_ALT=
QA_PASSWORD_ALT=
